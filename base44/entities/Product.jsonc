{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Productnaam (invoertaal - wordt automatisch vertaald)"
    },
    "name_nl": {
      "type": "string",
      "description": "Productnaam in het Nederlands"
    },
    "name_fr": {
      "type": "string",
      "description": "Nom du produit en fran\u00e7ais"
    },
    "name_en": {
      "type": "string",
      "description": "Product name in English"
    },
    "category_id": {
      "type": "string",
      "description": "Gekoppelde categorie ID"
    },
    "description": {
      "type": "string",
      "description": "Korte omschrijving van het product (invoertaal - wordt automatisch vertaald)"
    },
    "description_nl": {
      "type": "string",
      "description": "Korte omschrijving in het Nederlands"
    },
    "description_fr": {
      "type": "string",
      "description": "Description courte en fran\u00e7ais"
    },
    "description_en": {
      "type": "string",
      "description": "Short description in English"
    },
    "image_url": {
      "type": "string",
      "description": "Afbeelding URL van het product"
    },
    "order": {
      "type": "number",
      "description": "Volgorde binnen de categorie"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Actief/inactief"
    }
  },
  "required": [
    "name",
    "category_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teamleider"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_active": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teamleider"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teamleider"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}