{
  "name": "ProductionStep",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Gekoppeld product ID"
    },
    "title": {
      "type": "string",
      "description": "Titel van de stap (Dutch - deprecated, use title_nl)"
    },
    "title_nl": {
      "type": "string",
      "description": "Titel van de stap in het Nederlands"
    },
    "title_fr": {
      "type": "string",
      "description": "Titre de l'\u00e9tape en fran\u00e7ais"
    },
    "title_en": {
      "type": "string",
      "description": "Step title in English"
    },
    "description": {
      "type": "string",
      "description": "Uitleg en verduidelijking bij de stap (Dutch - deprecated, use description_nl)"
    },
    "description_nl": {
      "type": "string",
      "description": "Uitleg in het Nederlands"
    },
    "description_fr": {
      "type": "string",
      "description": "Explication en fran\u00e7ais"
    },
    "description_en": {
      "type": "string",
      "description": "Explanation in English"
    },
    "video_url": {
      "type": "string",
      "description": "URL van de instructievideo"
    },
    "order_index": {
      "type": "number",
      "description": "Volgorde index (100, 200, 300...). Laagste index = eerste stap."
    },
    "step_number": {
      "type": "number",
      "description": "Legacy: oud stapnummer (niet meer gebruikt)"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Geschatte duur in seconden"
    },
    "tips": {
      "type": "string",
      "description": "Extra tips of waarschuwingen (Dutch - deprecated, use tips_nl)"
    },
    "tips_nl": {
      "type": "string",
      "description": "Tips in het Nederlands"
    },
    "tips_fr": {
      "type": "string",
      "description": "Conseils en fran\u00e7ais"
    },
    "tips_en": {
      "type": "string",
      "description": "Tips in English"
    },
    "qc_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "label_nl": {
            "type": "string"
          },
          "label_fr": {
            "type": "string"
          },
          "label_en": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          }
        }
      },
      "description": "QC controlepunten, elk met een titel en optionele foto"
    },
    "qc_photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy: QC controle foto's (oud formaat)"
    },
    "qc_label": {
      "type": "string",
      "description": "Legacy: Label bij QC foto's (oud formaat)"
    }
  },
  "required": [
    "product_id",
    "title_nl",
    "order_index"
  ]
}