{
  "name": "ProductionStep",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Gekoppeld product ID"
    },
    "title": {
      "type": "string",
      "description": "Titel van de stap"
    },
    "description": {
      "type": "string",
      "description": "Uitleg en verduidelijking bij de stap"
    },
    "video_url": {
      "type": "string",
      "description": "URL van de instructievideo"
    },
    "order_index": {
      "type": "number",
      "description": "Volgorde index (100, 200, 300...). Laagste index = eerste stap."
    },
    "step_number": {
      "type": "number",
      "description": "Legacy: oud stapnummer (niet meer gebruikt)"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Geschatte duur in seconden"
    },
    "tips": {
      "type": "string",
      "description": "Extra tips of waarschuwingen"
    },
    "qc_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          }
        }
      },
      "description": "QC controlepunten, elk met een titel en optionele foto"
    },
    "qc_photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy: QC controle foto's (oud formaat)"
    },
    "qc_label": {
      "type": "string",
      "description": "Legacy: Label bij QC foto's (oud formaat)"
    }
  },
  "required": [
    "product_id",
    "title",
    "order_index"
  ]
}